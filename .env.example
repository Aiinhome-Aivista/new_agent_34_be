FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
FLASK_PORT=5000

# Relational Database (MySQL 8.0)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=fraud_investigation_db
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DB}?charset=utf8mb4

# Distributed Locking & Task Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Vector Database (ChromaDB for Policy RAG)
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=fraud_investigation_policies

# Graph Database (ArangoDB for Entity Correlation)
ARANGO_HOST=http://localhost:8529
ARANGO_DB=fraud_graph_db
ARANGO_USER=root
ARANGO_PASSWORD=replace-with-secure-password

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Active Provider Options: "gemini" | "openai" | "claude" | "azure_openai" | "custom"
LLM_PROVIDER=gemini

# ── 1. Google Gemini Settings ───────────────────────────────────────────────
# Primary key (fallback if per-agent keys not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── 2. OpenAI (ChatGPT / GPT-4o) ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ── 3. Anthropic Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── 4. Azure OpenAI / Copilot ───────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── 5. Local / Custom LLM (Ollama, vLLM, Mistral) ───────────────────────────
LLM_API_URL=
LLM_MODEL=mistral-small:24b
LLM_TIMEOUT=300

# Action Service Configuration
ACTION_SERVICE_URL=http://localhost:5001/api/v1/actions
ACTION_SERVICE_TOKEN=replace-with-action-service-bearer-token

# Logging & Operational Parameters
LOG_LEVEL=INFO
IDEMPOTENCY_TTL_SECONDS=86400
INVESTIGATION_TIMEOUT_SECONDS=120
